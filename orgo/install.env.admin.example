# install.env for the ADMIN box (Jake's me.rereset.ai command center).
# Stamps the SAME golden template as a client box, but PORTAL_ROLE=admin keeps /me +
# the fleet view and leaves the tenant filter unset (sees all tenants). Fill the
# <...> values from the live VPS /opt/rereset-portal/.env.local + 1Password, then:
#   sudo bash /opt/install-box.sh
# (Brain is MIGRATED, not init'd: skip stage_brain_init, restore the pg_dump instead.
#  See mind/jake-orgo-migration-plan-2026-06-28.md.)

CLIENT_SLUG=jake
SKILL_PROFILE=base                  # Jake is admin, not a team-member client profile

# --- Portal role: the whole point of this file ---
PORTAL_ROLE=admin
PORTAL_DOMAIN=me.rereset.ai          # keep the hostname; just repoint DNS to this box's tunnel
ADMIN_ALLOWLIST=jake@rspur.com

# --- Shared SSO secrets: copy BYTE-IDENTICAL from the live VPS so client-subdomain SSO survives ---
AUTH_SECRET=<copy from VPS .env.local AUTH_SECRET>
AUTH_COOKIE_DOMAIN=.rereset.ai
AUTH_GOOGLE_ID=<copy from VPS>
AUTH_GOOGLE_SECRET=<copy from VPS>
PORTAL_INGEST_SECRET=<copy from VPS INGEST_SECRET>   # every fleet box writes through this

# --- Tailnet: off-box writers (laptop/M4/Hermes task-board MCP) reach this box's Postgres over it ---
TS_AUTHKEY=<tailscale auth key>

# --- Brain: match the migrated brain, do NOT use the 1536-dim default ---
GBRAIN_EMBED_MODEL=ollama:nomic-embed-text   # 768-dim, matches the M4 brain we are restoring
OLLAMA_API_KEY=<ollama cloud key>            # hermes chat (gpt-oss); embeddings run via local ollama on the box

# --- Standard box plumbing (same as a client box) ---
GITHUB_TOKEN=<box deploy PAT>
COMPOSIO_API_KEY=<per-box composio PROJECT key, minted off-box>
AGENTMAIL_INBOX=<jake-rereset@agentmail.to or similar>
AGENTMAIL_API_KEY=<inbox-scoped key>

# PORTAL_ALLOWLIST stays empty for the admin box (admin gates via ADMIN_ALLOWLIST + @rspur.com).
PORTAL_ALLOWLIST=
