#!/usr/bin/env python3
"""rentcast-comp - budget-capped RentCast comp fetcher. ONE address per call.

Usage: rentcast-comp "123 Main St, Denver, CO 80202" [--rent] [--json]
Env:   RENTCAST_API_KEY (required), RENTCAST_DAILY_CAP (25), RENTCAST_MONTHLY_CAP (400)
State: /var/lib/rentcast/usage.json  (counters increment BEFORE the request)
Exit:  0 ok | 2 no key | 3 CAP_EXCEEDED | 4 api error | 5 bad usage
"""
import json, os, sys, time, urllib.parse, urllib.request

def die(code, msg):
    print(msg); sys.exit(code)

args = [a for a in sys.argv[1:] if not a.startswith("--")]
flags = {a for a in sys.argv[1:] if a.startswith("--")}
if len(args) != 1:
    die(5, "usage: rentcast-comp \"<one address>\" [--rent] [--json]  (one address per call, no batch mode by design)")
addr = args[0]
key = os.environ.get("RENTCAST_API_KEY", "")
if not key: die(2, "NO_KEY: RENTCAST_API_KEY not set on this box")

day_cap = int(os.environ.get("RENTCAST_DAILY_CAP", "25"))
mon_cap = int(os.environ.get("RENTCAST_MONTHLY_CAP", "400"))
state_dir = "/var/lib/rentcast"; os.makedirs(state_dir, exist_ok=True)
sf = os.path.join(state_dir, "usage.json")
now = time.localtime(); day = time.strftime("%Y-%m-%d", now); mon = time.strftime("%Y-%m", now)
u = {"day": day, "day_n": 0, "mon": mon, "mon_n": 0}
if os.path.exists(sf):
    try: u.update(json.load(open(sf)))
    except Exception: pass
if u["day"] != day: u["day"], u["day_n"] = day, 0
if u["mon"] != mon: u["mon"], u["mon_n"] = mon, 0
if u["day_n"] >= day_cap: die(3, f"CAP_EXCEEDED: daily cap {day_cap} used; resets at midnight")
if u["mon_n"] >= mon_cap: die(3, f"CAP_EXCEEDED: monthly cap {mon_cap} used; resets on the 1st")
u["day_n"] += 1; u["mon_n"] += 1
json.dump(u, open(sf, "w"))

path = "/avm/rent-long-term" if "--rent" in flags else "/avm/value"
url = f"https://api.rentcast.io/v1{path}?" + urllib.parse.urlencode({"address": addr, "compCount": 10})
req = urllib.request.Request(url, headers={"X-Api-Key": key, "Accept": "application/json"})
try:
    body = urllib.request.urlopen(req, timeout=30).read().decode()
except Exception as e:
    die(4, f"API_ERROR: {e}")
d = json.loads(body)
if "--json" in flags:
    print(body)
else:
    kind = "rent" if "--rent" in flags else "value"
    print(f"{kind} estimate: {d.get('rent') or d.get('price')} (range {d.get('rentRangeLow') or d.get('priceRangeLow')}-{d.get('rentRangeHigh') or d.get('priceRangeHigh')})")
    for c in (d.get("comparables") or [])[:10]:
        print(f"- {c.get('formattedAddress','?')} | {c.get('price')} | {c.get('squareFootage')}sf {c.get('bedrooms')}bd/{c.get('bathrooms')}ba | {c.get('distance'):.2f}mi | corr {c.get('correlation')}")
print(f"[budget: {u['day_n']}/{day_cap} today, {u['mon_n']}/{mon_cap} this month]", file=sys.stderr)
